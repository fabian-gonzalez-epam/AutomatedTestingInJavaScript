{
  "name": "TrelloAutomationTest",
  "version": "0.0.1",
  "description": "Automation testing of the website Trello",
  "private": true,
  "scripts": {
    "ui_test": "wdio run src/config/ui.conf.js",
    "api_test": "wdio run src/config/api.conf.js",
    "test": "npm run ui_test && npm run api_test",
    "linters": "npx prettier . --write && npx esLint",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@wdio/allure-reporter": "^8.39.0",
    "@wdio/cli": "^8.39.1",
    "@wdio/local-runner": "^8.39.1",
    "@wdio/mocha-framework": "^8.39.0",
    "@wdio/spec-reporter": "^8.39.0",
    "@wdio/visual-service": "^5.1.0",
    "allure-commandline": "^2.29.0",
    "eslint": "^9.7.0",
    "globals": "^15.8.0",
    "husky": "^9.1.2",
    "lint-staged": "^15.2.7",
    "prettier": "3.3.3"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "chai": "^5.1.1",
    "prettier-plugin-gherkin": "^2.4.0",
    "wdio-html-nice-reporter": "^8.1.6"
  }
}
